{
  "root": true,
  "ignorePatterns": [
    "projects/**/*",
    "dist/**/*",
    "coverage/**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/prefer-on-push-component-change-detection": "error",
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/explicit-member-accessibility": [
          "error",
          {
            "accessibility": "no-public"
          }
        ],
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_"
          }
        ],
        "eqeqeq": [
          "error",
          "always"
        ],
        "no-console": [
          "error",
          {
            "allow": [
              "error"
            ]
          }
        ],
        "@angular-eslint/component-class-suffix": [
          "error",
          {
            "suffixes": [
              "Component",
              "Page"
            ]
          }
        ],
        "import/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": "./src/app/features/auth",
                "from": "./src/app/features",
                "except": [
                  "./auth"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/features/catalogo",
                "from": "./src/app/features",
                "except": [
                  "./catalogo"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/features/ingresos",
                "from": "./src/app/features",
                "except": [
                  "./ingresos"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/features/trazabilidad",
                "from": "./src/app/features",
                "except": [
                  "./trazabilidad"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/features/consulta",
                "from": "./src/app/features",
                "except": [
                  "./consulta"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/features/consolidacion",
                "from": "./src/app/features",
                "except": [
                  "./consolidacion"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/features/auditoria",
                "from": "./src/app/features",
                "except": [
                  "./auditoria"
                ],
                "message": "Un feature no importa de otro feature: lo compartido sube a shared/ o models/, y entre features se navega por URL."
              },
              {
                "target": "./src/app/shared",
                "from": "./src/app/features",
                "message": "shared/ no depende de ning\u00fan feature."
              },
              {
                "target": "./src/app/core",
                "from": "./src/app/features",
                "message": "core/ no depende de ning\u00fan feature."
              },
              {
                "target": "./src/app/models",
                "from": [
                  "./src/app/core",
                  "./src/app/shared",
                  "./src/app/features"
                ],
                "message": "models/ solo describe formas: no depende de nada."
              }
            ]
          }
        ]
      },
      "plugins": [
        "import"
      ],
      "settings": {
        "import/resolver": {
          "typescript": {
            "project": "./tsconfig.json"
          }
        }
      }
    },
    {
      "files": [
        "src/app/features/*/pages/**/*.ts",
        "src/app/features/*/ui/**/*.ts",
        "src/app/shared/**/*.ts"
      ],
      "excludedFiles": [
        "*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@angular/common/http",
                "message": "Solo data-access/ (y el n\u00facleo HTTP de core/) habla con HttpClient."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "*.html"
      ],
      "extends": [
        "plugin:@angular-eslint/template/recommended",
        "plugin:@angular-eslint/template/accessibility"
      ],
      "rules": {}
    }
  ]
}
